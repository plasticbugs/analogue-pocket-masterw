`verilator_config
// Vendored cores are waived by rule and path. They are kept exactly as
// upstream wrote them so they stay diffable, and nothing under rtl/ is
// waived here: a genuine don't-care there gets its own narrow lint_off
// in the source, with the reason on the line above it.
lint_off -rule ALWCOMBORDER -file "*/cpu-fx68k/*"
lint_off -rule BLKANDNBLK -file "*/cpu-fx68k/*"
lint_off -rule BLKSEQ -file "*/cpu-fx68k/*"
lint_off -rule CASEINCOMPLETE -file "*/cpu-fx68k/*"
lint_off -rule CMPCONST -file "*/cpu-fx68k/*"
lint_off -rule EOFNEWLINE -file "*/cpu-fx68k/*"
lint_off -rule GENUNNAMED -file "*/cpu-fx68k/*"
lint_off -rule IMPLICIT -file "*/cpu-fx68k/*"
lint_off -rule LATCH -file "*/cpu-fx68k/*"
lint_off -rule MULTIDRIVEN -file "*/cpu-fx68k/*"
lint_off -rule PINMISSING -file "*/cpu-fx68k/*"
lint_off -rule PROCASSINIT -file "*/cpu-fx68k/*"
lint_off -rule REALCVT -file "*/cpu-fx68k/*"
lint_off -rule SELRANGE -file "*/cpu-fx68k/*"
lint_off -rule SYNCASYNCNET -file "*/cpu-fx68k/*"
