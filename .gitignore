# MAME working state, shadow romset (symlinks to the user's ROMs) and its
# snapshot output
.mame/
/snap/
# The user's romset — never commit ROMs.  Anchored: unanchored, this also
# matched pkg/pocket/Assets/masterw/, and silently kept the package's own
# README out of the repo (METHODOLOGY section 5.6).
/masterw/
*.zip
*.rom
*.bin
!pkg/**/*.bin
# Build products
projects/db/
projects/incremental_db/
projects/output_files/
.build/
release/
sim/obj_*/
tmp/
**/__pycache__/
.DS_Store

# Recorded audio: large, and regenerated by the benches and the MAME probes.
# They land in artifacts/audio/ for listening to locally; the comparison
# report next to them is what gets committed.
artifacts/audio/*.wav

# sim/lint.sh builds its waiver file to match the installed Verilator
sim/waivers.vlt
sim/obj_*.log

# raw frame dumps from the benches; the PNG beside each is what is kept
artifacts/**/*.rgb
